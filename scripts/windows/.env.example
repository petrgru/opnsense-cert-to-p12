# OPNsense Certificate-to-P12 Exporter — Windows Installer Configuration
#
# Copy this file to .env (same directory as install-cert.ps1) and fill in
# your OPNsense connection details.

# OPNsense server URL (required)
# Example: https://192.168.1.1
OPNSENSE_URL=https://opnsense.example.com

# API credentials (required)
# Create an API key in System → Access → Users → API keys on your OPNsense.
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Certificate name to download (required)
# Must match the --cert parameter used in cert-to-p12.sh on OPNsense.
# Examples: webgui, letsencrypt, or a specific refid
CERT_NAME=webgui

# Local directory for downloaded .p12 and .password files (optional)
# Defaults to: C:\ProgramData\cert-to-p12
# P12_DIR=C:\ProgramData\cert-to-p12

# Skip TLS certificate validation (optional, default: false)
# Set to true if your OPNsense uses a self-signed certificate.
# WARNING: Disabling certificate validation reduces security and
#          exposes the connection to man-in-the-middle attacks.
SKIP_TLS_VERIFY=false
